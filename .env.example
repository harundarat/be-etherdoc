# Application
PORT=3000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://etherdoc:etherdoc@localhost:5432/etherdoc

# Canonical source and destination RPC
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
INK_SEPOLIA_RPC_URL=https://rpc-qnd-sepolia.inkonchain.com
MANTLE_CONFIRMATION_DEPTH=2
INK_CONFIRMATION_DEPTH=2
RPC_REQUEST_TIMEOUT_MS=15000
INTENT_SIGNATURE_TTL_SECONDS=600

# Leave these unset once generated deployment manifests are available.
ETHERDOC_SENDER_ADDRESS=
ETHERDOC_RECEIVER_ADDRESS=

# Development/testnet only. Production must inject a managed signer secret.
BACKEND_PRIVATE_KEY=0x<64-hex-characters>

# SIWE and JWT
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_NONCE_TTL_SECONDS=300
SIWE_SESSION_TTL_SECONDS=900
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRES_IN=15m

# Pinata
PINATA_API_URL=https://api.pinata.cloud/v3
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
PINATA_JWT_TOKEN=<runtime-secret>
