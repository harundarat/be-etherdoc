# Application
PORT=3000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
API_REPLICA_COUNT=1
DATABASE_URL=postgresql://etherdoc:etherdoc@localhost:5432/etherdoc

# In-memory limiter; keep one API replica until a shared store is implemented.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_SEARCH_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=8

# Canonical source and destination RPC
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
ETHEREUM_CONFIRMATION_DEPTH=2
MANTLE_CONFIRMATION_DEPTH=2
RPC_REQUEST_TIMEOUT_MS=15000
INTENT_SIGNATURE_TTL_SECONDS=600
DISPATCH_FEE_BUFFER_BPS=1000
MAXIMUM_DISPATCH_FEE_WEI=10000000000000000000
CCIP_RECOVERY_AFTER_SECONDS=3600
OUTBOX_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=600000
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
CHAIN_INDEX_BLOCK_RANGE=2000
CHAIN_INDEX_INTERVAL_MS=15000

# Leave these unset once generated deployment manifests are available.
ETHERDOC_SENDER_ADDRESS=
ETHERDOC_RECEIVER_ADDRESS=
ETHERDOC_SENDER_DEPLOYMENT_BLOCK=
ETHERDOC_RECEIVER_DEPLOYMENT_BLOCK=

# Development/testnet only. Production must inject a managed signer secret.
BACKEND_PRIVATE_KEY=0x<64-hex-characters>

# SIWE and JWT
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_NONCE_TTL_SECONDS=300
SIWE_SESSION_TTL_SECONDS=900
AUTH_NONCE_RETENTION_SECONDS=604800
AUTH_NONCE_CLEANUP_INTERVAL_SECONDS=3600
AUTH_NONCE_CLEANUP_BATCH_SIZE=500
JWT_SECRET=<at-least-32-random-characters>

# Pinata
PINATA_API_URL=https://api.pinata.cloud/v3
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
PINATA_JWT_TOKEN=<runtime-secret>
